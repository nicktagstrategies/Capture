# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://capture:capture@localhost:5432/capture?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=replace-me-with-long-random-string
JWT_REFRESH_SECRET=replace-me-with-another-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Apple Sign In
APPLE_CLIENT_ID=com.capture.app
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
APPLE_PRIVATE_KEY_PATH=./keys/AuthKey.p8

# Google Sign In
GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Fees (dollars converted to cents at runtime)
FLAT_CUSTOMER_FEE_CENTS=150
COMMISSION_RATE=0.10

# Cancellation policy (hours from session start)
HOURS_FOR_FULL_REFUND=48
HOURS_FOR_PARTIAL_REFUND=24
PARTIAL_REFUND_RATE=0.5

# Object storage (S3-compatible). For local dev we recommend MinIO.
S3_REGION=us-west-2
S3_BUCKET=capture-galleries-dev
S3_ENDPOINT=                           # leave blank for AWS; set http://localhost:9000 for MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false              # true for MinIO

# Support inbox (transactional email goes here; stub logs only for now)
SUPPORT_INBOX_EMAIL=support@capture.app
