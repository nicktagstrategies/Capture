// Capture Prisma schema
// PostGIS is enabled via the raw SQL migration that runs `CREATE EXTENSION postgis;`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  customer
  photographer
  both
}

enum ServiceCategory {
  portrait
  wedding
  wedding_video
  event
  family
  headshot
  other
}

enum SlotStatus {
  open
  held
  booked
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  refunded
}

enum CancelledBy {
  customer
  photographer
  platform
}

enum GalleryStatus {
  awaiting_delivery
  delivered
}

enum GalleryItemStatus {
  pending_upload
  ready
  removed
}

enum SupportCategory {
  booking
  payment
  photographer
  account
  other
}

enum VoucherCategory {
  any
  wedding_video
  portrait
  event
  family
  headshot
}

enum VoucherStatus {
  /// Sender created the voucher but their payment is still processing.
  pending_payment
  /// Payment succeeded; recipient can redeem it.
  active
  /// Recipient applied it to a booking.
  redeemed
  /// Sender's payment failed or was refunded; voucher is dead.
  voided
}

enum TipStatus {
  /// PaymentIntent created; waiting for client confirmation + webhook.
  pending_payment
  /// Tip cleared; photographer has been credited.
  paid
  /// Stripe canceled or failed the PaymentIntent; tip is dead.
  voided
}

enum ReferralStatus {
  /// Code shared but recipient hasn't claimed yet (no row exists in this state today;
  /// reserved for outbound-email flows where we mint a Referral before signup).
  pending
  /// Recipient signed up + claimed; both sides got credit.
  signed_up
  /// Recipient redeemed credit on a booking.
  redeemed
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  avatarUrl     String?
  role          UserRole @default(customer)
  appleSub      String?  @unique
  googleSub     String?  @unique
  passwordHash  String?

  /// 6-char alphanumeric code other users can paste to give us both credit.
  /// Nullable for backfill — existing users get one minted on next sign-in.
  referralCode        String?  @unique
  /// Unspent referral credit, in cents. Decremented when applied to a booking.
  referralCreditCents Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  photographerProfile PhotographerProfile?
  paymentMethods      PaymentMethod[]
  bookings            Booking[]          @relation("CustomerBookings")
  sentVouchers        Voucher[]          @relation("VoucherSender")
  receivedVouchers    Voucher[]          @relation("VoucherRecipient")
  devices             Device[]
  refreshTokens       RefreshToken[]
  supportTickets      SupportTicket[]
  referralsSent       Referral[]         @relation("Referrer")
  referralsReceived   Referral[]         @relation("Referee")

  @@index([role])
}

model PhotographerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio               String?
  homeCity          String
  homeAddress       String?
  heroImageUrl      String?
  hourlyRateCents   Int      @default(0)
  stripeAccountId   String?  @unique
  verifiedAt        DateTime?
  avgRating         Float    @default(0)
  ratingCount       Int      @default(0)
  // IANA tz, e.g. "America/Los_Angeles". Slot DateTimes are stored UTC; the app
  // formats them in the photographer's timezone so "11:00 am" stays consistent
  // regardless of where the customer travels from.
  timezone          String   @default("America/Los_Angeles")
  // PostGIS point column is added via raw SQL migration; see migrations/ for details.
  // Prisma cannot model the GEOGRAPHY type directly, so it lives unmanaged.
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  services          Service[]
  slots             AvailabilitySlot[]
  bookings          Booking[]

  @@index([homeCity])
}

model Service {
  id              String          @id @default(cuid())
  photographerId  String
  photographer    PhotographerProfile @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationMinutes Int
  priceCents      Int
  category        ServiceCategory
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  bookings        Booking[]

  @@index([photographerId])
  @@index([category])
}

model AvailabilitySlot {
  id             String     @id @default(cuid())
  photographerId String
  photographer   PhotographerProfile @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  status         SlotStatus @default(open)
  heldUntil      DateTime?
  createdAt      DateTime   @default(now())

  booking        Booking?

  @@index([photographerId, startsAt])
  @@index([status])
}

model PaymentMethod {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripePaymentMethodId  String   @unique
  brand                  String
  last4                  String
  expMonth               Int
  expYear                Int
  isDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())

  @@index([userId])
}

model Booking {
  id                     String        @id @default(cuid())
  customerId             String
  customer               User          @relation("CustomerBookings", fields: [customerId], references: [id])
  photographerId         String
  photographer           PhotographerProfile @relation(fields: [photographerId], references: [id])
  serviceId              String
  service                Service       @relation(fields: [serviceId], references: [id])
  slotId                 String        @unique
  slot                   AvailabilitySlot @relation(fields: [slotId], references: [id])
  status                 BookingStatus @default(pending)

  subtotalCents          Int
  customerFeeCents       Int
  commissionCents        Int
  discountCents          Int           @default(0)
  totalCents             Int

  stripePaymentIntentId  String?       @unique
  stripeClientSecret     String?

  bookingAddress         String?
  startsAt               DateTime
  endsAt                 DateTime

  voucherId              String?       @unique
  voucher                Voucher?      @relation("VoucherRedemption", fields: [voucherId], references: [id])

  review                 Review?
  gallery                Gallery?
  messageThread          MessageThread?
  tip                    Tip?

  // Cancellation bookkeeping. cancelledBy + reason help support and analytics;
  // refundAmountCents records what we actually returned to the customer once
  // the Stripe refund completes.
  cancelledAt            DateTime?
  cancelledBy            CancelledBy?
  cancelReason           String?
  refundAmountCents      Int?

  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([customerId, startsAt])
  @@index([photographerId, startsAt])
  @@index([status])
}

/// Gift cards. Sender pays for them up-front via Stripe; only `active`
/// vouchers (= payment confirmed) are redeemable. Without this, anyone could
/// mint free percentage-off vouchers and gift them around.
model Voucher {
  id                            String          @id @default(cuid())
  senderId                      String
  sender                        User            @relation("VoucherSender", fields: [senderId], references: [id])
  recipientId                   String
  recipient                     User            @relation("VoucherRecipient", fields: [recipientId], references: [id])
  percentOff                    Int
  category                      VoucherCategory @default(any)
  note                          String?
  expiresAt                     DateTime
  status                        VoucherStatus   @default(pending_payment)
  purchaseAmountCents           Int
  purchaseStripePaymentIntentId String?         @unique
  purchaseClientSecret          String?
  redeemedAt                    DateTime?
  redeemedBooking               Booking?        @relation("VoucherRedemption")
  createdAt                     DateTime        @default(now())

  @@index([recipientId, status])
  @@index([senderId])
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  rating     Int
  body       String?
  createdAt  DateTime @default(now())
}

model Device {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apnsToken  String   @unique
  platform   String   @default("ios")
  createdAt  DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Stripe event IDs we've already processed. Stripe retries on 5xx and may
/// deliver the same event multiple times; we no-op on replays.
model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

/// Idempotency cache for unsafe endpoints. Clients send `Idempotency-Key`;
/// the server stores the response keyed by (userId, key) so retries replay
/// the original outcome instead of double-charging.
model IdempotencyKey {
  id           String   @id @default(cuid())
  userId       String
  key          String
  method       String
  path         String
  statusCode   Int
  responseBody String   // serialized JSON
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

/// Photo delivery container — one per Booking. Photographers upload to it after
/// the session; customers view, share, and download from it. `portfolioConsent`
/// controls whether the photographer may use these photos in their public
/// portfolio (default false; customer flips it explicitly).
model Gallery {
  id                String        @id @default(cuid())
  bookingId         String        @unique
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  status            GalleryStatus @default(awaiting_delivery)
  notes             String?
  portfolioConsent  Boolean       @default(false)
  deliveredAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             GalleryItem[]
  shareLinks        GalleryShareLink[]
}

model GalleryItem {
  id          String            @id @default(cuid())
  galleryId   String
  gallery     Gallery           @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  storageKey  String            // S3 object key
  mimeType    String
  bytes       Int?
  width       Int?
  height      Int?
  status      GalleryItemStatus @default(pending_upload)
  uploadedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([galleryId])
}

/// Public, time-limited gallery access via opaque token. Customer issues the
/// token from the gallery view; recipients hit `/public/galleries/:token` and
/// see the gallery without needing a Capture account.
model GalleryShareLink {
  id         String    @id @default(cuid())
  galleryId  String
  gallery    Gallery   @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  token      String    @unique
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([galleryId])
}

model SupportTicket {
  id         String          @id @default(cuid())
  userId     String?
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  email      String
  category   SupportCategory @default(other)
  subject    String
  body       String
  bookingId  String?
  createdAt  DateTime        @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Per-booking message thread between customer and photographer. Auto-created
/// on first send so we don't have to backfill threads for every booking.
/// Locked once the booking has been completed for a week (enforced in the
/// route, not at the DB layer).
model MessageThread {
  id              String    @id @default(cuid())
  bookingId       String    @unique
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId      String
  photographerId  String   // PhotographerProfile.id, not User.id
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())

  messages        Message[]

  @@index([customerId])
  @@index([photographerId])
}

/// "Give $10, get $10": a referrer's code is claimed by a referee on signup
/// (or shortly after). Both sides get `creditCents` added to their balance.
/// Booking checkout auto-applies available credit, capped at the booking's
/// platform application fee so Capture never loses cash on a single booking.
model Referral {
  id              String         @id @default(cuid())
  referrerId      String
  referrer        User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId       String?
  referee         User?          @relation("Referee", fields: [refereeId], references: [id], onDelete: SetNull)
  refereeEmail    String?        // populated for outbound-email referrals before signup
  code            String         // snapshot of referrer.referralCode at claim time
  creditCents     Int            @default(1000)
  status          ReferralStatus @default(signed_up)
  redeemedBookingId String?
  createdAt       DateTime       @default(now())
  redeemedAt      DateTime?

  @@index([referrerId])
  @@index([refereeId])
}

/// Optional gratuity attached to a completed booking. 100% goes to the
/// photographer — Capture takes no platform cut on tips. Stored as a separate
/// PaymentIntent so it can be charged at a different time than the booking
/// (and so the original booking's refund/transfer logic isn't entangled with
/// tip dollars).
model Tip {
  id                    String    @id @default(cuid())
  bookingId             String    @unique
  booking               Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId            String
  photographerId        String   // PhotographerProfile.id
  amountCents           Int
  status                TipStatus @default(pending_payment)
  stripePaymentIntentId String?   @unique
  stripeClientSecret    String?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?

  @@index([photographerId, status])
}

model Message {
  id                  String        @id @default(cuid())
  threadId            String
  thread              MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId            String        // User.id of whoever sent it
  body                String?       // text body; null when message is purely an attachment or location pin
  attachmentUrl       String?       // S3 URL once uploaded; presigned at read time
  attachmentMime      String?
  // Ephemeral location pin: lat/lng valid only until locationExpiresAt.
  locationLat         Float?
  locationLng         Float?
  locationExpiresAt   DateTime?
  createdAt           DateTime      @default(now())
  readAt              DateTime?

  @@index([threadId, createdAt])
}
